import logging



logging.basicConfig(filename="app.log", level=logging.ERROR)



def safe_get_price(ticker):



    try:



        data = fetch_live_price(ticker)



        return data.get("price") if data else None



    except Exception as e:



        logging.error(f"{ticker}: {e}")



        return None
